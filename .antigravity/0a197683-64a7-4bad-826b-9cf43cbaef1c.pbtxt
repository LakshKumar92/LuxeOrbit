    replacement_chunks {
      replacement_content: "import { Canvas } from \'@react-three/fiber\';\nimport { MeshDistortMaterial, Sphere, Environment, Float } from \'@react-three/drei\';\nimport { ThemeType } from \'../App\';\n\nexport default function ModelView({ theme }: { theme: ThemeType }) {\n  const getMaterialProps = () => {\n    switch (theme) {\n      case \'noir\':\n        return { color: \'#050505\', metalness: 0.8, roughness: 0.2, clearcoat: 1 };\n      case \'alabaster\':\n        return { color: \'#f3ece5\', metalness: 0.1, roughness: 0.7, clearcoat: 0.1 };\n      case \'prismatic\':\n        return { \n          color: \'#ffffff\', \n          metalness: 0.2, \n          roughness: 0.05, \n          transmission: 1, \n          ior: 1.5, \n          thickness: 2,\n          envMapIntensity: 2\n        };\n      default:\n        return {};\n    }\n  };\n\n  const getBackground = () => {\n    switch (theme) {\n      case \'noir\': return \'#0a0a0b\';\n      case \'alabaster\': return \'#e8e2db\';\n      case \'prismatic\': return \'#d5d9e0\';\n      default: return \'#0a0a0b\';\n    }\n  };\n\n  return (\n    <div \n      className=\"absolute inset-0 z-0 transition-colors duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)]\" \n      style={{ backgroundColor: getBackground() }}\n    >\n      <Canvas camera={{ position: [0, 0, 4.5], fov: 45 }}>\n        <ambientLight intensity={theme === \'alabaster\' ? 1.5 : 0.2} />\n        <directionalLight position={[10, 10, 5]} intensity={theme === \'noir\' ? 2 : 1} />\n        <directionalLight position={[-10, -10, -5]} intensity={0.5} />\n        \n        <Environment \n          preset={theme === \'prismatic\' ? \'city\' : \'studio\'} \n          environmentIntensity={theme === \'noir\' ? 0.3 : 1}\n        />\n        \n        <Float speed={2.5} rotationIntensity={1.5} floatIntensity={1.2}>\n          {/* Abstract representation of the human form / fabric */}\n          <Sphere args={[1.1, 128, 128]}>\n            <MeshDistortMaterial \n              distort={0.35} \n              speed={1.5} \n              {...getMaterialProps()} \n            />\n          </Sphere>\n        </Float>\n      </Canvas>\n    </div>\n  );\n}\n"
    }
