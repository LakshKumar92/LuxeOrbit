  file_change {
    absolute_path_uri: "file:///src/components/LuxuryUI.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { motion } from \'motion/react\';\nimport { Menu, Search, ShoppingBag, ArrowRight } from \'lucide-react\';\nimport { ThemeType } from \'../App\';\n\ninterface LuxuryUIProps {\n  theme: ThemeType;\n  setTheme: (t: ThemeType) => void;\n}\n\nexport default function LuxuryUI({ theme, setTheme }: LuxuryUIProps) {\n  const isDark = theme === \'noir\';\n  const textColor = isDark ? \'text-white\' : \'text-slate-900\';\n  const borderColor = isDark ? \'border-white/20\' : \'border-slate-900/20\';\n\n  return (\n    <div className={`relative z-10 w-full h-full flex flex-col pointer-events-none ${textColor} transition-colors duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)]`}>\n      {/* Navigation */}\n      <nav className={`w-full flex items-center justify-between px-6 md:px-12 py-8 pointer-events-auto`}>\n        <div className=\"flex items-center gap-6\">\n          <button className=\"hover:opacity-70 transition-opacity\">\n            <Menu strokeWidth={1} size={28} />\n          </button>\n          <div className=\"hidden md:flex gap-8 font-sans text-sm tracking-[0.2em] uppercase\">\n            <button className=\"hover:opacity-70 transition-opacity\">Collections</button>\n            <button className=\"hover:opacity-70 transition-opacity\">Body Profiles</button>\n            <button className=\"hover:opacity-70 transition-opacity\">Maisons</button>\n          </div>\n        </div>\n        \n        <div className=\"absolute left-1/2 -translate-x-1/2\">\n          <h1 className=\"font-serif text-3xl tracking-widest uppercase\">Aura</h1>\n        </div>\n\n        <div className=\"flex items-center gap-6\">\n          <button className=\"hover:opacity-70 transition-opacity\">\n            <Search strokeWidth={1} size={24} />\n          </button>\n          <button className=\"hover:opacity-70 transition-opacity\">\n            <ShoppingBag strokeWidth={1} size={24} />\n          </button>\n        </div>\n      </nav>\n\n      {/* Main Content */}\n      <main className=\"flex-1 flex flex-col justify-center px-6 md:px-12 w-full max-w-7xl mx-auto pointer-events-none\">\n        <div className=\"max-w-2xl\">\n          <motion.div\n            initial={{ opacity: 0, y: 20 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 1.2, ease: [0.16, 1, 0.3, 1] }}\n          >\n            <h2 className=\"font-serif text-5xl md:text-7xl lg:text-8xl leading-[1.1] mb-6\">\n              Precision <br className=\"hidden md:block\"/>\n              <span className=\"italic font-light\">in form.</span>\n            </h2>\n          </motion.div>\n          \n          <motion.div\n            initial={{ opacity: 0, y: 20 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 1.2, delay: 0.2, ease: [0.16, 1, 0.3, 1] }}\n          >\n            <p className=\"font-sans text-lg md:text-xl font-light opacity-80 max-w-md leading-relaxed text-balance mb-12\">\n              Discover curated garments mathematically matched to your exact proportions, visualized in true three dimensions.\n            </p>\n          </motion.div>\n          \n          <motion.div\n            initial={{ opacity: 0, y: 20 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 1.2, delay: 0.4, ease: [0.16, 1, 0.3, 1] }}\n            className=\"pointer-events-auto\"\n          >\n            <button className={`group flex items-center gap-4 border-b pb-2 ${borderColor} hover:border-current transition-colors`}>\n              <span className=\"font-sans text-sm tracking-[0.2em] uppercase\">Begin Virtual Fitting</span>\n              <ArrowRight strokeWidth={1.5} size={18} className=\"group-hover:translate-x-2 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]\" />\n            </button>\n          </motion.div>\n        </div>\n      </main>\n\n      {/* Footer / Theme Selector */}\n      <footer className=\"w-full flex flex-col md:flex-row items-start md:items-end justify-between px-6 md:px-12 py-8 pointer-events-auto\">\n        <div className=\"font-sans text-xs tracking-widest uppercase opacity-60 mb-6 md:mb-0\">\n          <p>Global Directory</p>\n          <p className=\"mt-1\">\302\251 2026 Aura Technologies</p>\n        </div>\n\n        <div className=\"flex flex-col items-start md:items-end gap-3\">\n          <p className=\"font-sans text-[10px] tracking-[0.2em] uppercase opacity-50\">Select Aesthetic Direction</p>\n          <div className=\"flex gap-4\">\n            {([\'noir\', \'alabaster\', \'prismatic\'] as ThemeType[]).map((t) => (\n              <button\n                key={t}\n                onClick={() => setTheme(t)}\n                className={`font-sans text-xs tracking-[0.15em] uppercase px-4 py-2 border rounded-full transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]\n                  ${theme === t \n                    ? `bg-current ${isDark ? \'text-black\' : \'text-white\'}` \n                    : `bg-transparent ${borderColor} hover:border-current`\n                  }`}\n              >\n                {t}\n              </button>\n            ))}\n          </div>\n        </div>\n      </footer>\n    </div>\n  );\n}\n"
    }
