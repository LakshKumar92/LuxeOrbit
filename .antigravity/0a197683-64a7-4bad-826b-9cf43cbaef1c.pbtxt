  run_command {
    cwd: "/"
    exit_code: 0
    blocking: true
    wait_ms_before_async: 5000
    combined_output {
      full: "Success"
    }
    command_line: "cat << \'EOF\' > fix_clothes_data.cjs\nconst fs = require(\'fs\');\nlet content = fs.readFileSync(\'src/data/clothes.ts\', \'utf8\');\n\nlet match = content.match(/export const CLOTHING_DATABASE: ClothingItem\\[\\] = (\\[[\\s\\S]*?\\]);/);\nif (match) {\n    let db = eval(match[1]);\n    \n    for (let item of db) {\n        // Fix Body Types\n        if (item.category.includes(\'Menswear\') && !item.category.includes(\'Womenswear\')) {\n            item.bodyTypes = item.bodyTypes.filter(bt => bt !== \'Curvy / Hourglass\');\n        }\n        if (item.category.includes(\'Womenswear\') && !item.category.includes(\'Menswear\')) {\n            item.bodyTypes = item.bodyTypes.filter(bt => bt !== \'Broad / Structured\');\n        }\n        \n        // Fix Kurta Shalwar Image\n        if (item.name === \'Classic Black Kurta Shalwar\') {\n            item.imageUrl = \"https://upload.wikimedia.org/wikipedia/commons/5/5e/Kurta_-_Mens.jpg\";\n        }\n        \n        // Fix Sherwani Image\n        if (item.name === \'Embroidered Sherwani\') {\n            item.imageUrl = \"https://upload.wikimedia.org/wikipedia/commons/1/14/Creative_wedding_photography.jpg\";\n        }\n    }\n    \n    let newContent = content.replace(match[0], `export const CLOTHING_DATABASE: ClothingItem[] = ${JSON.stringify(db, null, 2)};`);\n    fs.writeFileSync(\'src/data/clothes.ts\', newContent);\n    console.log(\"Success\");\n} else {\n    console.log(\"Not found\");\n}\nEOF\nnode fix_clothes_data.cjs"
    proposed_command_line: "cat << \'EOF\' > fix_clothes_data.cjs\nconst fs = require(\'fs\');\nlet content = fs.readFileSync(\'src/data/clothes.ts\', \'utf8\');\n\nlet match = content.match(/export const CLOTHING_DATABASE: ClothingItem\\[\\] = (\\[[\\s\\S]*?\\]);/);\nif (match) {\n    let db = eval(match[1]);\n    \n    for (let item of db) {\n        // Fix Body Types\n        if (item.category.includes(\'Menswear\') && !item.category.includes(\'Womenswear\')) {\n            item.bodyTypes = item.bodyTypes.filter(bt => bt !== \'Curvy / Hourglass\');\n        }\n        if (item.category.includes(\'Womenswear\') && !item.category.includes(\'Menswear\')) {\n            item.bodyTypes = item.bodyTypes.filter(bt => bt !== \'Broad / Structured\');\n        }\n        \n        // Fix Kurta Shalwar Image\n        if (item.name === \'Classic Black Kurta Shalwar\') {\n            item.imageUrl = \"https://upload.wikimedia.org/wikipedia/commons/5/5e/Kurta_-_Mens.jpg\";\n        }\n        \n        // Fix Sherwani Image\n        if (item.name === \'Embroidered Sherwani\') {\n            item.imageUrl = \"https://upload.wikimedia.org/wikipedia/commons/1/14/Creative_wedding_photography.jpg\";\n        }\n    }\n    \n    let newContent = content.replace(match[0], `export const CLOTHING_DATABASE: ClothingItem[] = ${JSON.stringify(db, null, 2)};`);\n    fs.writeFileSync(\'src/data/clothes.ts\', newContent);\n    console.log(\"Success\");\n} else {\n    console.log(\"Not found\");\n}\nEOF\nnode fix_clothes_data.cjs"
    shell_name: "bash"
  }
}
