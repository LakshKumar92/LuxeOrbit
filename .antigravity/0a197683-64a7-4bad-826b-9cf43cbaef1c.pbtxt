.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=originalleather jacket: https://upload.wikimedia.org/wikipedia/commons/a/aa/Black_worn_leather_jacket_detail_1.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=originalleggings front: https://upload.wikimedia.org/wikipedia/commons/5/52/Leggings_%28Berlin%29_2019-001.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=originalsundress flat: no resultsmom jeans flat: https://upload.wikimedia.org/wikipedia/commons/0/03/Best_Lincoln_stories%2C_tersely_told_%28IA_bestlincolnstori1898gall%29.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=originalsilk blouse: https://upload.wikimedia.org/wikipedia/commons/6/67/Blouse_MET_CI63.38.3_F.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original"
    }
    command_line: "cat << \'EOF\' > fix_images2.cjs\nconst https = require(\'https\');\n\nconst options = {\n  headers: {\n    \'User-Agent\': \'CoolApp/1.0 (someone@example.com)\'\n  }\n};\n\nasync function searchWiki(query) {\n  return new Promise((resolve) => {\n    const url = `https://commons.wikimedia.org/w/api.php?action=query&list=search&srsearch=${encodeURIComponent(query)}&srnamespace=6&format=json&srlimit=5`;\n    https.get(url, options, (res) => {\n      let data = \'\';\n      res.on(\'data\', d => data += d);\n      res.on(\'end\', () => {\n        try {\n          resolve(JSON.parse(data).query.search.map(s => s.title));\n        } catch(e) { resolve([]); }\n      });\n    });\n  });\n}\n\nasync function getUrl(title) {\n  return new Promise((resolve) => {\n    const url = `https://commons.wikimedia.org/w/api.php?action=query&prop=imageinfo&iiprop=url&titles=${encodeURIComponent(title)}&format=json`;\n    https.get(url, options, (res) => {\n      let data = \'\';\n      res.on(\'data\', d => data += d);\n      res.on(\'end\', () => {\n        try {\n          const pages = JSON.parse(data).query.pages;\n          const page = Object.values(pages)[0];\n          resolve(page.imageinfo ? page.imageinfo[0].url : null);\n        } catch(e) { resolve(null); }\n      });\n    });\n  });\n}\n\nasync function main() {\n  const queries = [\n    \'charcoal suit\', \'white dress shirt\', \'mens chinos\', \'hoodie front\', \n    \'track jacket\', \'mens shorts\', \'blue jeans flat\', \'navy blazer\',\n    \'evening gown front\', \'pencil skirt\', \'knit sweater\', \'leather jacket\',\n    \'leggings front\', \'sundress flat\', \'mom jeans flat\', \'silk blouse\'\n  ];\n  for (const q of queries) {\n    const titles = await searchWiki(q);\n    if (titles.length > 0) {\n      let url = await getUrl(titles[0]);\n      console.log(`${q}: ${url}`);\n    } else {\n      console.log(`${q}: no results`);\n    }\n  }\n}\nmain();\nEOF\nnode fix_images2.cjs\n"
    proposed_command_line: "cat << \'EOF\' > fix_images2.cjs\nconst https = require(\'https\');\n\nconst options = {\n  headers: {\n    \'User-Agent\': \'CoolApp/1.0 (someone@example.com)\'\n  }\n};\n\nasync function searchWiki(query) {\n  return new Promise((resolve) => {\n    const url = `https://commons.wikimedia.org/w/api.php?action=query&list=search&srsearch=${encodeURIComponent(query)}&srnamespace=6&format=json&srlimit=5`;\n    https.get(url, options, (res) => {\n      let data = \'\';\n      res.on(\'data\', d => data += d);\n      res.on(\'end\', () => {\n        try {\n          resolve(JSON.parse(data).query.search.map(s => s.title));\n        } catch(e) { resolve([]); }\n      });\n    });\n  });\n}\n\nasync function getUrl(title) {\n  return new Promise((resolve) => {\n    const url = `https://commons.wikimedia.org/w/api.php?action=query&prop=imageinfo&iiprop=url&titles=${encodeURIComponent(title)}&format=json`;\n    https.get(url, options, (res) => {\n      let data = \'\';\n      res.on(\'data\', d => data += d);\n      res.on(\'end\', () => {\n        try {\n          const pages = JSON.parse(data).query.pages;\n          const page = Object.values(pages)[0];\n          resolve(page.imageinfo ? page.imageinfo[0].url : null);\n        } catch(e) { resolve(null); }\n      });\n    });\n  });\n}\n\nasync function main() {\n  const queries = [\n    \'charcoal suit\', \'white dress shirt\', \'mens chinos\', \'hoodie front\', \n    \'track jacket\', \'mens shorts\', \'blue jeans flat\', \'navy blazer\',\n    \'evening gown front\', \'pencil skirt\', \'knit sweater\', \'leather jacket\',\n    \'leggings front\', \'sundress flat\', \'mom jeans flat\', \'silk blouse\'\n  ];\n  for (const q of queries) {\n    const titles = await searchWiki(q);\n    if (titles.length > 0) {\n      let url = await getUrl(titles[0]);\n      console.log(`${q}: ${url}`);\n    } else {\n      console.log(`${q}: no results`);\n    }\n  }\n}\nmain();\nEOF\nnode fix_images2.cjs\n"
