ull\"],\n    \"style\": [\"Streetwear / Urban\"],\n    \"priceEst\": \"PKR 6,500\",\n    \"buyUrl\": \"https://example.com/hoodie1\",\n    \"imageUrl\": \"https://loremflickr.com/800/800/mens,hoodie,streetwear?lock=4\",\n    \"description\": \"A heavyweight oversized hoodie with minimalist back graphics.\"\n  },\n  {\n    \"id\": \"m-athletic-new-1\",\n    \"brand\": \"ActiveCore\",\n    \"name\": \"Performance Track Jacket\",\n    \"category\": [\"Menswear\"],\n    \"bodyTypes\": [\"Athletic / Muscular\", \"Slim / Slender\"],\n    \"style\": [\"Athletic / Athleisure\"],\n    \"priceEst\": \"PKR 5,500\",\n    \"buyUrl\": \"https://example.com/trackjacket1\",\n    \"imageUrl\": \"https://loremflickr.com/800/800/mens,tracksuit,sports?lock=5\",\n    \"description\": \"A sleek, moisture-wicking track jacket for optimal athletic performance.\"\n  },\n  {\n    \"id\": \"m-resort-new-1\",\n    \"brand\": \"Coastal\",\n    \"name\": \"Linen Blend Shorts\",\n    \"category\": [\"Menswear\"],\n    \"bodyTypes\": [\"Broad / Structured\", \"Slim / Slender\"],\n    \"style\": [\"Bohemian / Resort\"],\n    \"priceEst\": \"PKR 3,200\",\n    \"buyUrl\": \"https://example.com/shorts1\",\n    \"imageUrl\": \"https://loremflickr.com/800/800/mens,shorts,summer?lock=6\",\n    \"description\": \"Breathable linen-blend shorts for warm weather getaways.\"\n  },\n  {\n    \"id\": \"m-casual-new-2\",\n    \"brand\": \"Denim Co\",\n    \"name\": \"Slim Fit Jeans\",\n    \"category\": [\"Menswear\"],\n    \"bodyTypes\": [\"Slim / Slender\", \"Athletic / Muscular\"],\n    \"style\": [\"Casual Everyday\"],\n    \"priceEst\": \"PKR 5,800\",\n    \"buyUrl\": \"https://example.com/jeans1\",\n    \"imageUrl\": \"https://loremflickr.com/800/800/mens,jeans,denim?lock=7\",\n    \"description\": \"Classic blue denim jeans tailored with a comfortable slim fit.\"\n  },\n  {\n    \"id\": \"m-formal-new-3\",\n    \"brand\": \"Sartorial\",\n    \"name\": \"Navy Blue Blazer\",\n    \"category\": [\"Menswear\"