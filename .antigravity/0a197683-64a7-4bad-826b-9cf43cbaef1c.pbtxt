      title: "ralphlauren.com"
    }
    web_documents {
      url: "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQEhU2MRvbXyfRPRyyy7HtLtlKhmnhPm4TkbUnf5ChRJ1Ap9G3dOERBsdQiplfljKJ9dBOnOaRvT5f_jjAX2-dnZLCrld8gMKnet2JbYNerlXo3ej3Yw3bspAMHXng5t0w1n454_UsNvMmxuTouF6sv2Pw=="
      title: "ralphlauren.com"
    }
    summary: "The search query \"site:unsplash.com \"polo shirt\"\" will display images of polo shirts available on Unsplash. Unsplash is a website that provides free-to-use stock photography.\n\nA polo shirt, also known as a tennis shirt, golf shirt, or chukker shirt, is a collared shirt typically made of knitted cotton, often a piqu\303\251 knit[1]. These shirts usually have short sleeves but can also be long-sleeved[1]. The design was first introduced by Ren\303\251 Lacoste, a French tennis champion, in 1926, who found traditional tennis attire cumbersome[1]. The polo shirt\'s features, such as the unstarched collar, buttoned placket, and a longer back hem (known as a \"tennis tail\"), were designed for comfort and ease of movement during play[1]. The piqu\303\251 collar could also be worn upturned to protect the neck from the sun[1].\n\nThe Ralph Lauren Polo shirt, first introduced in 1972, is a widely recognized icon of culture and style, available in various colors, prints, and fits for both men and women[2][3].\n\nSources:\n[1] [wikipedia.org](https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQE5C1pGdRILqiNT5cHgaQxVz4UULWPxa7oejEuaO0Fb6Sov2qHiLUDWdMuGz5ZeOVVbx1CCf5i2n4OUdzJPxpQjn4LgCmebHejm6CitptbpOZewc4Xj4N-sp6EZb1tNrpICs00=)\n[2] [ralphlauren.com](https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQF5GrE9uQxlhkONSpdSLG1AiJZK1-Tcor3gLMHr_vzRBUFrfJoZmPROjNq5BjhXW-fcYvjl-C2isZV6Ans3BljTxaIFqOPmx2I44L5SSL-dqZ_3LPcgO7ZQr0TBkIMlRKPkpWalEFIPTnqAO7yXHLc=)\n[3] [ralphlauren.com](https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQEhU2MRvbXyfRPRyyy7HtLtlKhmnhPm4TkbUnf5ChRJ1Ap9G3dOERBsdQiplfljKJ9dBOnOaRvT5f_jjAX2-dnZLCrld8gMKnet2JbYNerlXo3ej3Yw3bspAMHXng5t0w1n454_UsNvMmxuTouF6sv2Pw==)"
    third_party_config {
      provider: THIRD_PARTY_WEB_SEARCH_PROVIDER_GEMINI
    }
    search_type: SEARCH_WEB_TYPE_WEB
  }
}
