  file_change {
    absolute_path_uri: "file:///src/components/VirtualFitting.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import { useState } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { ArrowLeft, Loader2, ExternalLink } from \'lucide-react\';\n\ninterface VirtualFittingProps {\n  onBack: () => void;\n  isDark: boolean;\n}\n\ninterface StylistResponse {\n  outfits: Outfit[];\n}\n\ninterface Outfit {\n  outfitName: string;\n  description: string;\n  items: ClothingItem[];\n}\n\ninterface ClothingItem {\n  brand: string;\n  name: string;\n  category: string;\n  priceEst?: string;\n  buyUrl: string;\n}\n\nconst CATEGORIES = [\"Menswear\", \"Womenswear\", \"Gender Neutral\"];\nconst BODY_TYPES = [\"Slim / Slender\", \"Athletic / Muscular\", \"Broad / Structured\", \"Curvy / Hourglass\", \"Round / Full\"];\nconst STYLES = [\"Casual Everyday\", \"Elevated Formal\", \"Luxury Streetwear\", \"Minimalist Chic\", \"Avant-Garde\"];\n\nexport default function VirtualFitting({ onBack, isDark }: VirtualFittingProps) {\n  const [step, setStep] = useState(1);\n  const [selections, setSelections] = useState({ category: \'\', bodyType: \'\', style: \'\' });\n  const [loading, setLoading] = useState(false);\n  const [outfits, setOutfits] = useState<Outfit[]>([]);\n  const [error, setError] = useState(\'\');\n\n  const textColor = isDark ? \'text-white\' : \'text-slate-900\';\n  const borderColor = isDark ? \'border-white/20\' : \'border-slate-900/20\';\n  const bgColor = isDark ? \'bg-black/40\' : \'bg-white/40\';\n  const buttonHover = isDark ? \'hover:bg-white hover:text-black\' : \'hover:bg-slate-900 hover:text-white\';\n\n  const handleSelection = (key: keyof typeof selections, value: string) => {\n    const newSelections = { ...selections, [key]: value };\n    setSelections(newSelections);\n    \n    if (step === 1) setStep(2);\n    else if (step === 2) setStep(3);\n    else if (step === 3) handleGenerate(newSelections);\n  };\n\n  const handleGenerate = async (finalSelections: typeof selections) => {\n    setLoading(true);\n    setError(\'\');\n    setStep(4);\n    \n    const preferences = `Category: ${finalSelections.category}, Body Type: ${finalSelections.bodyType}, Style: ${finalSelections.style}`;\n    \n    try {\n      const response = await fetch(\'/api/stylist\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ preferences }),\n      });\n      \n      if (!response.ok) {\n        if (response.status === 429) {\n          throw new Error(\'API Quota Exceeded. Please check your Gemini API plan or try again later.\');\n        }\n        throw new Error(\'Failed to fetch recommendations\');\n      }\n      \n      const data: StylistResponse = await response.json();\n      setOutfits(data.outfits);\n    } catch (err: any) {\n      setError(err.message || \'An error occurred while curating your wardrobe. Please try again.\');\n      setStep(3); // Go back so they can try again\n      console.error(err);\n    } finally {\n      setLoading(false);\n    }\n  };"
      replacement_content: "import { useState, useEffect } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { ArrowLeft, Loader2, ExternalLink, User, Gem, Users, Activity, Dumbbell, Square, Waves, Circle, Coffee, Briefcase, Map, Minus, Triangle, ImageIcon } from \'lucide-react\';\n\ninterface VirtualFittingProps {\n  onBack: () => void;\n  isDark: boolean;\n}\n\ninterface StylistResponse {\n  outfits: Outfit[];\n}\n\ninterface Outfit {\n  outfitName: string;\n  description: string;\n  items: ClothingItem[];\n  imageUrl?: string;\n  loadingImage?: boolean;\n}\n\ninterface ClothingItem {\n  brand: string;\n  name: string;\n  category: string;\n  priceEst?: string;\n  buyUrl: string;\n}\n\nconst CATEGORIES = [\n  { name: \"Menswear\", icon: User },\n  { name: \"Womenswear\", icon: Gem },\n  { name: \"Gender Neutral\", icon: Users }\n];\n\nconst BODY_TYPES = [\n  { name: \"Slim / Slender\", icon: Activity },\n  { name: \"Athletic / Muscular\", icon: Dumbbell },\n  { name: \"Broad / Structured\", icon: Square },\n  { name: \"Curvy / Hourglass\", icon: Waves },\n  { name: \"Round / Full\", icon: Circle }\n];\n\nconst STYLES = [\n  { name: \"Casual Everyday\", icon: Coffee },\n  { name: \"Elevated Formal\", icon: Briefcase },\n  { name: \"Luxury Streetwear\", icon: Map },\n  { name: \"Minimalist Chic\", icon: Minus },\n  { name: \"Avant-Garde\", icon: Triangle }\n];\n\nexport default function VirtualFitting({ onBack, isDark }: VirtualFittingProps) {\n  const [step, setStep] = useState(1);\n  const [selections, setSelections] = useState({ category: \'\', bodyType: \'\', style: \'\' });\n  const [loading, setLoading] = useState(false);\n  const [outfits, setOutfits] = useState<Outfit[]>([]);\n  const [error, setError] = useState(\'\');\n\n  const textColor = isDark ? \'text-white\' : \'text-slate-900\';\n  const borderColor = isDark ? \'border-white/20\' : \'border-slate-900/20\';\n  const bgColor = isDark ? \'bg-black/40\' : \'bg-white/40\';\n  const buttonHover = isDark ? \'hover:bg-white hover:text-black\' : \'hover:bg-slate-900 hover:text-white\';\n\n  const handleSelection = (key: keyof typeof selections, value: string) => {\n    const newSelections = { ...selections, [key]: value };\n    setSelections(newSelections);\n    \n    if (step === 1) setStep(2);\n    else if (step === 2) setStep(3);\n    else if (step === 3) handleGenerate(newSelections);\n  };\n\n  const handleGenerate = async (finalSelections: typeof selections) => {\n    setLoading(true);\n    setError(\'\');\n    setStep(4);\n    \n    const preferences = `Category: ${finalSelections.category}, Body Type: ${finalSelections.bodyType}, Style: ${finalSelections.style}`;\n    \n    try {\n      const response = await fetch(\'/api/stylist\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ preferences }),\n      });\n      \n      if (!response.ok) {\n        if (response.status === 429) {\n          throw new Error(\'API Quota Exceeded. Please check your Gemini API plan or try again later.\');\n        }\n        throw new Error(\'Failed to fetch recommendations\');\n      }\n      \n      const data: StylistResponse = await response.json();\n      \n      // Initialize outfits with loadingImage true\n      const initialOutfits = data.outfits.map(o => ({ ...o, loadingImage: true }));\n      setOutfits(initialOutfits);\n      \n      // Kick off image generation for each outfit in parallel\n      initialOutfits.forEach((outfit, index) => {\n        fetchOutfitImage(outfit, index);\n      });\n      \n    } catch (err: any) {\n      setError(err.message || \'An error occurred while curating your wardrobe. Please try again.\');\n      setStep(3); // Go back so they can try again\n      console.error(err);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const fetchOutfitImage = async (outfit: Outfit, index: number) => {\n    try {\n      // Build a comprehensive description for the image generator\n      const fullDescription = `${outfit.outfitName}. ${outfit.description}. Items included: ${outfit.items.map(i => `${i.brand} ${i.name}`).join(\', \')}.`;\n      \n      const response = await fetch(\'/api/generate-outfit-image\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ description: fullDescription }),\n      });\n      \n      if (response.ok) {\n        const data = await response.json();\n        setOutfits(prev => {\n          const newOutfits = [...prev];\n          newOutfits[index] = { ...newOutfits[index], imageUrl: data.image, loadingImage: false };\n          return newOutfits;\n        });\n      } else {\n        throw new Error(\'Failed to load image\');\n      }\n    } catch (err) {\n      console.error(\"Error generating image for outfit\", err);\n      setOutfits(prev => {\n        const newOutfits = [...prev];\n        newOutfits[index] = { ...newOutfits[index], loadingImage: false };\n        return newOutfits;\n      });\n    }\n  };"
    }
