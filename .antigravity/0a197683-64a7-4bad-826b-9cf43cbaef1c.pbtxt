    }
    command_line: "cat << \'EOF\' > fix_all_images.cjs\nconst fs = require(\'fs\');\n\nlet content = fs.readFileSync(\'src/data/clothes.ts\', \'utf-8\');\n\n// The goal is to replace ALL wikimedia links with stable unsplash images. \n// I will just fetch a set of reliable unsplash IDs and assign them linearly \n// so every single image is completely unique and works.\n\nconst allMatches = [...content.matchAll(/\"imageUrl\": \"(.*?)\"/g)];\nconst uniqueUrls = [...new Set(allMatches.map(m => m[1]))];\nconst wikimediaUrls = uniqueUrls.filter(u => u.includes(\'wikimedia.org\'));\n\nconsole.log(\"Found \" + wikimediaUrls.length + \" wikimedia urls to replace\");\n\n// A large set of 30 Unsplash clothing/fashion images that are public and stable\nconst unsplashIds = [\n  \"1591047139829-19fc5863fb7a\", // generic mens shirt\n  \"1512436991641-01f2f81498b5\", // suit\n  \"1475178626620-27827e8d5337\", // formal dress\n  \"1503342394128-c104d54dba01\", // casual wear\n  \"1585487000160-6ebcfceb0d03\", // denim\n  \"1552374196-1ab2a1c593e8\", // hoodie\n  \"1584273143981-41c073dfe8f8\", // cargo\n  \"1551488831-00ddcb6c6bd3\", // jacket\n  \"1620799140408-edc6dcb6d633\", // sweater\n  \"1509631179647-0177331693ae\", // blazer\n  \"1594938298603-c8148c4dae35\", // chinos\n  \"1593030761757-71fae45fa0e7\", // formal suit\n  \"1490481651871-ab68de25d43d\", // gown\n  \"1529139574466-a303027c1d8b\", // skirt\n  \"1515886657613-9f3515b0c78f\", // activewear\n  \"1610030469983-98e550d6193c\", // resort\n  \"1605763240000-7e93b172d754\", // dress\n  \"1598532163257-ae3c6b2524b6\", // casual\n  \"1520975954732-35dd22299614\", // jacket\n  \"1539008835657-9e8e9680c956\", // coat\n  \"1574015974293-817f0ebebb74\", // knit\n  \"1591561954557-26941169b49e\", // new1\n  \"1485230895920-ee9cf164ec14\", // new2\n  \"1508215885820-4585e5b85437\", // new3\n  \"1434389677353-84725048b066\", // new4\n  \"1545291730-fbf8739d2242\"     // new5\n];\n\nlet unsplashIndex = 0;\n\nfor (const wikiUrl of wikimediaUrls) {\n  if (unsplashIndex >= unsplashIds.length) {\n    unsplashIndex = 0; // loop if needed, though we have 26 and need 20\n  }\n  const unsplashUrl = `https://images.unsplash.com/photo-${unsplashIds[unsplashIndex]}?auto=format&fit=crop&q=80&w=800`;\n  content = content.replace(new RegExp(wikiUrl.replace(/[-\\/\\\\^$*+?.()|[\\]{}]/g, \'\\\\$&\'), \'g\'), unsplashUrl);\n  unsplashIndex++;\n}\n\nfs.writeFileSync(\'src/data/clothes.ts\', content, \'utf-8\');\nconsole.log(\"Replaced all Wikimedia URLs\");\nEOF\nnode fix_all_images.cjs\n"
    proposed_command_line: "cat << \'EOF\' > fix_all_images.cjs\nconst fs = require(\'fs\');\n\nlet content = fs.readFileSync(\'src/data/clothes.ts\', \'utf-8\');\n\n// The goal is to replace ALL wikimedia links with stable unsplash images. \n// I will just fetch a set of reliable unsplash IDs and assign them linearly \n// so every single image is completely unique and works.\n\nconst allMatches = [...content.matchAll(/\"imageUrl\": \"(.*?)\"/g)];\nconst uniqueUrls = [...new Set(allMatches.map(m => m[1]))];\nconst wikimediaUrls = uniqueUrls.filter(u => u.includes(\'wikimedia.org\'));\n\nconsole.log(\"Found \" + wikimediaUrls.length + \" wikimedia urls to replace\");\n\n// A large set of 30 Unsplash clothing/fashion images that are public and stable\nconst unsplashIds = [\n  \"1591047139829-19fc5863fb7a\", // generic mens shirt\n  \"1512436991641-01f2f81498b5\", // suit\n  \"1475178626620-27827e8d5337\", // formal dress\n  \"1503342394128-c104d54dba01\", // casual wear\n  \"1585487000160-6ebcfceb0d03\", // denim\n  \"1552374196-1ab2a1c593e8\", // hoodie\n  \"1584273143981-41c073dfe8f8\", // cargo\n  \"1551488831-00ddcb6c6bd3\", // jacket\n  \"1620799140408-edc6dcb6d633\", // sweater\n  \"1509631179647-0177331693ae\", // blazer\n  \"1594938298603-c8148c4dae35\", // chinos\n  \"1593030761757-71fae45fa0e7\", // formal suit\n  \"1490481651871-ab68de25d43d\", // gown\n  \"1529139574466-a303027c1d8b\", // skirt\n  \"1515886657613-9f3515b0c78f\", // activewear\n  \"1610030469983-98e550d6193c\", // resort\n  \"1605763240000-7e93b172d754\", // dress\n  \"1598532163257-ae3c6b2524b6\", // casual\n  \"1520975954732-35dd22299614\", // jacket\n  \"1539008835657-9e8e9680c956\", // coat\n  \"1574015974293-817f0ebebb74\", // knit\n  \"1591561954557-26941169b49e\", // new1\n  \"1485230895920-ee9cf164ec14\", // new2\n  \"1508215885820-4585e5b85437\", // new3\n  \"1434389677353-84725048b066\", // new4\n  \"1545291730-fbf8739d2242\"     // new5\n];\n\nlet unsplashIndex = 0;\n\nfor (const wikiUrl of wikimediaUrls) {\n  if (unsplashIndex >= unsplashIds.length) {\n    unsplashIndex = 0; // loop if needed, though we have 26 and need 20\n  }\n  const unsplashUrl = `https://images.unsplash.com/photo-${unsplashIds[unsplashIndex]}?auto=format&fit=crop&q=80&w=800`;\n  content = content.replace(new RegExp(wikiUrl.replace(/[-\\/\\\\^$*+?.()|[\\]{}]/g, \'\\\\$&\'), \'g\'), unsplashUrl);\n  unsplashIndex++;\n}\n\nfs.writeFileSync(\'src/data/clothes.ts\', content, \'utf-8\');\nconsole.log(\"Replaced all Wikimedia URLs\");\nEOF\nnode fix_all_images.cjs\n"
