      full: "charcoal suit: no resultswhite dress shirt: no resultsmens chinos: no resultsmens hoodie: no resultstrack jacket: no resultsmens shorts: no resultsblue jeans: no resultsnavy blazer: no resultsevening gown: no resultspencil skirt: no resultsknit sweater: no resultsleather jacket: no resultsleggings: no resultssundress: no resultsmom jeans: no resultssilk blouse: no results"
    }
    command_line: "cat << \'EOF\' > fix_images.cjs\nconst https = require(\'https\');\n\nasync function searchWiki(query) {\n  return new Promise((resolve) => {\n    const url = `https://commons.wikimedia.org/w/api.php?action=query&list=search&srsearch=${encodeURIComponent(query)}&srnamespace=6&format=json&srlimit=5`;\n    https.get(url, (res) => {\n      let data = \'\';\n      res.on(\'data\', d => data += d);\n      res.on(\'end\', () => {\n        try {\n          resolve(JSON.parse(data).query.search.map(s => s.title));\n        } catch(e) { resolve([]); }\n      });\n    });\n  });\n}\n\nasync function getUrl(title) {\n  return new Promise((resolve) => {\n    const url = `https://commons.wikimedia.org/w/api.php?action=query&prop=imageinfo&iiprop=url&titles=${encodeURIComponent(title)}&format=json`;\n    https.get(url, (res) => {\n      let data = \'\';\n      res.on(\'data\', d => data += d);\n      res.on(\'end\', () => {\n        try {\n          const pages = JSON.parse(data).query.pages;\n          const page = Object.values(pages)[0];\n          resolve(page.imageinfo ? page.imageinfo[0].url : null);\n        } catch(e) { resolve(null); }\n      });\n    });\n  });\n}\n\nasync function main() {\n  const queries = [\n    \'charcoal suit\', \'white dress shirt\', \'mens chinos\', \'mens hoodie\', \n    \'track jacket\', \'mens shorts\', \'blue jeans\', \'navy blazer\',\n    \'evening gown\', \'pencil skirt\', \'knit sweater\', \'leather jacket\',\n    \'leggings\', \'sundress\', \'mom jeans\', \'silk blouse\'\n  ];\n  for (const q of queries) {\n    const titles = await searchWiki(q);\n    if (titles.length > 0) {\n      const url = await getUrl(titles[0]);\n      console.log(`${q}: ${url}`);\n    } else {\n      console.log(`${q}: no results`);\n    }\n  }\n}\nmain();\nEOF\nnode fix_images.cjs\n"
    proposed_command_line: "cat << \'EOF\' > fix_images.cjs\nconst https = require(\'https\');\n\nasync function searchWiki(query) {\n  return new Promise((resolve) => {\n    const url = `https://commons.wikimedia.org/w/api.php?action=query&list=search&srsearch=${encodeURIComponent(query)}&srnamespace=6&format=json&srlimit=5`;\n    https.get(url, (res) => {\n      let data = \'\';\n      res.on(\'data\', d => data += d);\n      res.on(\'end\', () => {\n        try {\n          resolve(JSON.parse(data).query.search.map(s => s.title));\n        } catch(e) { resolve([]); }\n      });\n    });\n  });\n}\n\nasync function getUrl(title) {\n  return new Promise((resolve) => {\n    const url = `https://commons.wikimedia.org/w/api.php?action=query&prop=imageinfo&iiprop=url&titles=${encodeURIComponent(title)}&format=json`;\n    https.get(url, (res) => {\n      let data = \'\';\n      res.on(\'data\', d => data += d);\n      res.on(\'end\', () => {\n        try {\n          const pages = JSON.parse(data).query.pages;\n          const page = Object.values(pages)[0];\n          resolve(page.imageinfo ? page.imageinfo[0].url : null);\n        } catch(e) { resolve(null); }\n      });\n    });\n  });\n}\n\nasync function main() {\n  const queries = [\n    \'charcoal suit\', \'white dress shirt\', \'mens chinos\', \'mens hoodie\', \n    \'track jacket\', \'mens shorts\', \'blue jeans\', \'navy blazer\',\n    \'evening gown\', \'pencil skirt\', \'knit sweater\', \'leather jacket\',\n    \'leggings\', \'sundress\', \'mom jeans\', \'silk blouse\'\n  ];\n  for (const q of queries) {\n    const titles = await searchWiki(q);\n    if (titles.length > 0) {\n      const url = await getUrl(titles[0]);\n      console.log(`${q}: ${url}`);\n    } else {\n      console.log(`${q}: no results`);\n    }\n  }\n}\nmain();\nEOF\nnode fix_images.cjs\n"
    shell_name: "bash"
  }
