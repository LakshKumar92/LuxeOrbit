    command_line: "cat << \'EOF\' > fix_clothes.js\nconst fs = require(\'fs\');\nconst https = require(\'https\');\n\nasync function searchUnsplash(query) {\n  return new Promise((resolve) => {\n    https.get(`https://unsplash.com/napi/search/photos?query=${encodeURIComponent(query)}&per_page=5`, (res) => {\n      let data = \'\';\n      res.on(\'data\', d => data += d);\n      res.on(\'end\', () => {\n        try {\n          const json = JSON.parse(data);\n          if (json.results && json.results.length > 0) {\n            resolve(json.results[0].id);\n          } else {\n            resolve(null);\n          }\n        } catch(e) { resolve(null); }\n      });\n    });\n  });\n}\n\nasync function main() {\n  const file = \'src/data/clothes.ts\';\n  let content = fs.readFileSync(file, \'utf-8\');\n  \n  // Extract all clothing items by parsing the file\n  // Just use regex to find id and name\n  const regex = /\"id\":\\s*\"([^\"]+)\",[\\s\\S]*?\"name\":\\s*\"([^\"]+)\",[\\s\\S]*?\"imageUrl\":\\s*\"([^\"]+)\"/g;\n  const matches = [...content.matchAll(regex)];\n  \n  const replacements = [];\n  \n  for (const match of matches) {\n    const id = match[1];\n    const name = match[2];\n    const oldUrl = match[3];\n    \n    const unsplashId = await searchUnsplash(name + \" clothing\");\n    if (unsplashId) {\n      const newUrl = `https://images.unsplash.com/photo-${unsplashId}?auto=format&fit=crop&q=80&w=800`;\n      replacements.push({ id, name, oldUrl, newUrl });\n      console.log(`Found for ${name}: ${newUrl}`);\n    } else {\n      console.log(`Failed for ${name}`);\n    }\n  }\n  \n  let newContent = content;\n  for (const rep of replacements) {\n    // Find the specific block for this ID to replace only its imageUrl\n    const blockRegex = new RegExp(`(\"id\":\\\\s*\"${rep.id}\"[\\\\s\\\\S]*?)\"imageUrl\":\\\\s*\"[^\"]+\"`);\n    newContent = newContent.replace(blockRegex, `$1\"imageUrl\": \"${rep.newUrl}\"`);\n  }\n  \n  fs.writeFileSync(file, newContent, \'utf-8\');\n}\n\nmain();\nEOF\nnode fix_clothes.js\n"
