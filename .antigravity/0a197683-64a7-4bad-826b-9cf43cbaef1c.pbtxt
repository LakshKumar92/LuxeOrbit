enswear\"],\n    \"bodyTypes\": [\"Broad / Structured\", \"Athletic / Muscular\", \"Round / Full\"],\n    \"style\": [\"Elevated Formal\"],\n    \"priceEst\": \"PKR 25,000\",\n    \"buyUrl\": \"https://example.com/blazer1\",\n    \"imageUrl\": \"https://loremflickr.com/800/800/mens,blazer,navy?lock=8\",\n    \"description\": \"A versatile navy blazer that effortlessly elevates any smart-casual ensemble.\"\n  },\n  {\n    \"id\": \"w-formal-new-1\",\n    \"brand\": \"Elegance\",\n    \"name\": \"Silk Evening Gown\",\n    \"category\": [\"Womenswear\"],\n    \"bodyTypes\": [\"Curvy / Hourglass\", \"Slim / Slender\"],\n    \"style\": [\"Elevated Formal\"],\n    \"priceEst\": \"PKR 35,000\",\n    \"buyUrl\": \"https://example.com/gown1\",\n    \"imageUrl\": \"https://loremflickr.com/800/800/womens,dress,formal?lock=9\",\n    \"description\": \"A stunning floor-length silk gown designed for high-profile evening events.\"\n  },\n  {\n    \"id\": \"w-formal-new-2\",\n    \"brand\": \"Modernist\",\n    \"name\": \"Tailored Pencil Skirt\",\n    \"category\": [\"Womenswear\"],\n    \"bodyTypes\": [\"Curvy / Hourglass\", \"Athletic / Muscular\"],\n    \"style\": [\"Elevated Formal\", \"Minimalist Chic\"],\n    \"priceEst\": \"PKR 6,500\",\n    \"buyUrl\": \"https://example.com/skirt1\",\n    \"imageUrl\": \"https://loremflickr.com/800/800/womens,pencil,skirt?lock=10\",\n    \"description\": \"A structured pencil skirt that forms the cornerstone of professional attire.\"\n  },\n  {\n    \"id\": \"w-casual-new-1\",\n    \"brand\": \"Chic Basic\",\n    \"name\": \"Chunky Knit Sweater\",\n    \"category\": [\"Womenswear\"],\n    \"bodyTypes\": [\"Slim / Slender\", \"Round / Full\", \"Athletic / Muscular\"],\n    \"style\": [\"Casual Everyday\"],\n    \"priceEst\": \"PKR 5,200\",\n    \"buyUrl\": \"https://example.com/sweater1\",\n    \"imageUrl\": \"https://loremflickr.com/800/800/womens,sweater,knit?lock=11\",\n    \"description\": \"An incredibly cozy, oversized knit sweater for